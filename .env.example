# Frontend (https://wms-f.onrender.com) → Backend (https://wms-b.onrender.com)
NEXT_PUBLIC_API_ROOT_URL=https://wms-b.onrender.com

# Relative path — browser calls same-origin; Next.js rewrites to the backend
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Deploy URLs
# Frontend: https://wms-f.onrender.com
# Backend:  https://wms-b.onrender.com

# Optional: Super Admin JWT from POST /api/superadmin/login (must start with eyJ...)
# Do not commit real tokens — set only in local .env or Render env vars
NEXT_PUBLIC_JWT_TOKEN=
